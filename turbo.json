{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["../../dist/apps/**"],
      "cache": false,
      "env": ["PUBLIC_UMAMI_URL", "PUBLIC_UMAMI_WEBSITE_ID"]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../packages/**",
        "../../tsconfig.json",
        "../../apps/*/src/**"
      ],
      "outputs": []
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "//#build:lib": {
      "inputs": ["packages/volt/**", "angular.json", "tsconfig.json"],
      "outputs": ["dist/volt/**"]
    }
  }
}
