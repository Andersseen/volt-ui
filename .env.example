# Umami analytics (self-hosted) — optional for local dev.
# The deployed build receives these via .github/workflows/ci.yml with baked-in defaults,
# so the production site always ships the tracker even if repo vars are unset.
# Values are public by design (the Website ID ships in the page HTML).
PUBLIC_UMAMI_URL=https://umami.andersseen.dev/script.js
PUBLIC_UMAMI_WEBSITE_ID=5baf0049-5fed-401f-a71c-eb6af6ef3166

# Glossa project access token (catalog:read, catalog:write) for the volt-ui project.
# Only used by the "glossa" MCP server in .mcp.json (Authorization header, ${GLOSSA_TOKEN}
# expansion, read at Claude Code startup from this shell's environment — not auto-loaded
# from this file). The site itself never reads this at runtime; do not add a PUBLIC_ copy.
# Get one from https://glossa.andersseen.dev/projects/volt-ui → Access tokens.
GLOSSA_TOKEN=
