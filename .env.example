# Umami analytics (self-hosted) — optional for local dev.
# The deployed build receives these via .github/workflows/ci.yml with baked-in defaults,
# so the production site always ships the tracker even if repo vars are unset.
# Values are public by design (the Website ID ships in the page HTML).
PUBLIC_UMAMI_URL=https://umami.andersseen.dev/script.js
PUBLIC_UMAMI_WEBSITE_ID=5baf0049-5fed-401f-a71c-eb6af6ef3166
