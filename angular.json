{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "analytics": "8d511575-c890-4951-a20a-17cfebd9a4af"
  },
  "newProjectRoot": "packages",
  "projects": {
    "volt-ui": {
      "projectType": "application",
      "schematics": {},
      "root": "apps/web",
      "sourceRoot": "apps/web/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@analogjs/platform:vite",
          "options": {
            "outputPath": "dist/apps/web",
            "ssr": true,
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/web/public"
              }
            ],
            "styles": ["apps/web/src/styles.css"]
          },
          "configurations": {
            "production": {},
            "development": {}
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@analogjs/platform:vite-dev-server",
          "options": {
            "buildTarget": "volt-ui:build:development",
            "hmr": true
          },
          "configurations": {
            "production": {
              "buildTarget": "volt-ui:build:production"
            },
            "development": {
              "buildTarget": "volt-ui:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "recipes": {
      "projectType": "application",
      "schematics": {},
      "root": "apps/recipes",
      "sourceRoot": "apps/recipes/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@analogjs/platform:vite",
          "options": {
            "outputPath": "dist/apps/recipes",
            "ssr": true,
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/recipes/public"
              }
            ],
            "styles": ["apps/recipes/src/styles.css"]
          },
          "configurations": {
            "production": {},
            "development": {}
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@analogjs/platform:vite-dev-server",
          "options": {
            "buildTarget": "recipes:build:development",
            "hmr": true
          },
          "configurations": {
            "production": {
              "buildTarget": "recipes:build:production"
            },
            "development": {
              "buildTarget": "recipes:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "volt": {
      "projectType": "library",
      "root": "packages/volt",
      "sourceRoot": "packages/volt/src",
      "prefix": "volt",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "packages/volt/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "packages/volt/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "packages/volt/tsconfig.spec.json"
          }
        },
        "storybook": {
          "builder": "@storybook/angular-vite:start-storybook",
          "options": {
            "configDir": ".storybook",
            "tsConfig": "tsconfig.storybook.json",
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular-vite:build-storybook",
          "options": {
            "configDir": ".storybook",
            "tsConfig": "tsconfig.storybook.json",
            "outputDir": "dist/storybook"
          }
        }
      }
    }
  }
}
