#!/usr/bin/env node

const {
  loadManifest,
  copyComponent,
  initProject,
  listComponents,
  groupComponents,
  detectTailwindSetup,
  formatTailwindGuidance,
  resolveBase,
  writeConfig,
  readConfig,
  assertSupportedForBase,
  componentsForBase,
  targetUsesNgPrimitives,
  validateBase,
  DEFAULT_BASE,
  CONFIG_FILE,
} = require('../lib/core');

function parseArgs(rawArgs) {
  const args = [];
  const flags = {};
  for (const arg of rawArgs) {
    if (arg.startsWith('--')) {
      const [key, value] = arg.split('=');
      const normalizedKey = key.slice(2);
      flags[normalizedKey] = value !== undefined ? value : true;
    } else {
      args.push(arg);
    }
  }
  return { args, flags };
}

function parseAddArgs(args, manifest) {
  const candidates = args.slice(1);
  let targetDir = './src/app/ui';
  const componentNames = [];

  for (const candidate of candidates) {
    if (manifest.components[candidate]) {
      componentNames.push(candidate);
    } else if (componentNames.length > 0) {
      targetDir = candidate;
      break;
    } else {
      const available = Object.keys(manifest.components)
        .sort()
        .slice(0, 12)
        .join(', ');
      console.error(`❌ Component "${candidate}" not found.`);
      console.error(`Run "volt list" to see all components. Available examples: ${available}`);
      process.exit(1);
    }
  }

  return { componentNames, targetDir };
}

/**
 * Resolves the backend for this invocation and refuses to mix engines in a directory that already
 * holds the other one. Exits with a message instead of throwing a stack trace.
 */
function selectBase(flags, targetDir) {
  let selection;
  try {
    selection = resolveBase(flags.base);
  } catch (err) {
    console.error(`❌ ${err.message}`);
    process.exit(1);
  }
  if (selection.base !== DEFAULT_BASE && !selection.recorded && targetUsesNgPrimitives(targetDir)) {
    console.error(
      `❌ ${targetDir} already contains components copied with the ng-primitives base.\n` +
        `   Copying a Quartz component next to them would mix engines without a record of it.\n` +
        `   Use another target-dir, or keep using ng-primitives for this directory.`
    );
    process.exit(1);
  }
  return selection;
}

async function main() {
  const { args, flags } = parseArgs(process.argv.slice(2));
  const command = args[0];

  if (command === 'add') {
    if (args.length < 2) {
      console.error('❌ Please specify at least one component name.');
      console.log('Usage: volt add <component-name>... [target-dir] [--install] [--dry-run] [--force]');
      process.exit(1);
    }

    const manifest = await loadManifest();
    const { componentNames, targetDir } = parseAddArgs(args, manifest);
    const { base, requested, recorded } = selectBase(flags, targetDir);

    try {
      // Checked for the whole request up front, so a mixed list writes nothing.
      assertSupportedForBase(componentNames, manifest, base);
    } catch (err) {
      console.error(`❌ ${err.message}`);
      process.exit(1);
    }

    const results = [];
    for (const componentName of componentNames) {
      const result = await copyComponent(componentName, targetDir, manifest, {
        install: false, // install once at the end
        dryRun: !!flags['dry-run'],
        force: !!flags.force,
        base,
      });
      results.push(result);
    }

    // An explicit --base is remembered, so later `volt add` calls keep the same engine.
    if (requested && !recorded && !flags['dry-run']) writeConfig(requested);

    if (flags.install) {
      const { installDependencies } = require('../lib/core');
      const dependencies = [...new Set(results.flatMap(r => r.runtimeDependencies))];
      installDependencies(process.cwd(), { dryRun: !!flags['dry-run'], dependencies });
    }

    if (flags['dry-run']) {
      console.log(`\n🔎 Dry run: ${results.length} component(s) would be added to ${targetDir}`);
      for (const result of results) {
        console.log(`  - ${result.componentName}`);
        result.files.forEach(file => console.log(`    ${file}`));
      }
    } else {
      console.log(`\n✅ Added ${results.length} component(s) successfully to ${targetDir}`);
    }
    for (const result of results) {
      if (!flags['dry-run']) console.log(`  - ${result.componentName}`);
    }

    const allDependencies = [...new Set(results.flatMap(r => r.dependencies))];
    if (allDependencies.length > 0) {
      console.log(`\n📦 Required dependencies also copied:`);
      allDependencies.forEach(dep => console.log(`  - ${dep}`));
    }

    console.log(`\nImport in your component:`);
    for (const result of results) {
      console.log(`  import { ${result.className} } from './ui/${result.componentName}';`);
    }
    if (base !== DEFAULT_BASE) {
      console.log(`\n🧪 Headless base: ${base} (experimental).`);
    }

    if (flags.install) {
      console.log(flags['dry-run'] ? `\n🔎 Runtime dependencies would be installed.` : `\n✅ Runtime dependencies installed.`);
    } else {
      const firstResult = results[0];
      console.log(`\n⚠️  Ensure runtime dependencies are installed:`);
      console.log(`  ${firstResult.installCommand}`);
      console.log(
        `\n  Or run: volt add ${componentNames.join(' ')} ${targetDir} --install${base !== DEFAULT_BASE ? ` --base=${base}` : ''}`
      );
    }
  } else if (command === 'init') {
    const targetDir = args[1] || './src/app/ui';
    const { base, requested, recorded } = selectBase(flags, targetDir);
    initProject(targetDir);
    console.log('✅ Initialized volt/ui in', targetDir);
    // Only an explicit --base writes volt.json: a project that never asks keeps the old behaviour.
    if (requested && !recorded) {
      writeConfig(requested);
      console.log(`✅ Recorded base "${requested}" in ${CONFIG_FILE}`);
    }
    if (base !== DEFAULT_BASE) {
      const supported = componentsForBase(await loadManifest(), base);
      console.log(`🧪 The "${base}" base is experimental and supports: ${supported.join(', ')}.`);
    }

    const tailwind = detectTailwindSetup(process.cwd());
    if (!tailwind.configured) {
      console.log(`\n${formatTailwindGuidance(tailwind)}`);
    }
  } else if (command === 'list') {
    const manifest = await loadManifest();
    const status = typeof flags.status === 'string' ? flags.status : null;
    const validStatuses = ['stable', 'beta', 'experimental'];
    if (status && !validStatuses.includes(status)) {
      console.error(`❌ Unknown status "${status}". Use one of: ${validStatuses.join(', ')}`);
      process.exit(1);
    }

    let base;
    try {
      base = flags.base === undefined ? undefined : validateBase(flags.base);
    } catch (err) {
      console.error(`❌ ${err.message}`);
      process.exit(1);
    }
    const components = listComponents(manifest, { status, base });
    if (flags.json) {
      console.log(JSON.stringify(components, null, 2));
      return;
    }

    console.log(status ? `Available ${status} components:` : 'Available components:');
    const groups = groupComponents(components);
    for (const [group, items] of Object.entries(groups)) {
      console.log(`\n${group}`);
      for (const item of items) {
        const statusLabel = item.stability.padEnd(12);
        const description = item.description ? ` - ${item.description}` : '';
        console.log(`  - ${item.name.padEnd(16)} ${statusLabel}${description}`);
      }
    }
  } else {
    console.log('Volt UI CLI');
    console.log('');
    console.log('Usage:');
    console.log('  volt init [target-dir]                Initialize volt/ui in your project');
    console.log(
      '  volt init [target-dir] --base=quartz  Also record the headless base (ng-primitives | quartz)'
    );
    console.log(
      '  volt add <component>... [target-dir]  Add one or more components to your project'
    );
    console.log('  volt add <component>... [target-dir] --dry-run  Preview files without writing');
    console.log(
      '  volt add <component>... [target-dir] --force    Overwrite existing component files'
    );
    console.log(
      '  volt add <component>... --install     Add component(s) and install runtime deps'
    );
    console.log('  volt list                             List all available components');
    console.log('  volt list --status=stable             List components by stability');
    console.log('  volt list --json                      Print component metadata as JSON');
    console.log(
      '  volt list --base=quartz               List components that have a Quartz implementation'
    );
    console.log(
      '  volt add <component>... --base=quartz Copy the experimental Quartz Headless version'
    );
    console.log('');
    console.log('Examples:');
    console.log('  npx @voltui/cli init');
    console.log('  npx @voltui/cli add button');
    console.log('  npx @voltui/cli add button card input');
    console.log('  npx @voltui/cli add card --install');
    console.log('  npx @voltui/cli add checkbox switch toggle --base=quartz');
  }
}

main().catch(err => {
  console.error('❌ Unexpected error:', err.message);
  process.exit(1);
});
