#!/usr/bin/env node

const {
  loadManifest,
  initProject,
  installDependencies,
  listComponents,
  groupComponents,
  detectTailwindSetup,
  formatTailwindGuidance,
  resolveBase,
  writeConfig,
  readConfig,
  componentsForBase,
  classNameFor,
  targetUsesNgPrimitives,
  validateBase,
  DEFAULT_BASE,
  CONFIG_FILE,
} = require('../lib/core');
const { planAdd, formatConflicts, filesWithAction } = require('../lib/add-plan');
const { applyPlan } = require('../lib/apply-plan');

function parseArgs(rawArgs) {
  const args = [];
  const flags = {};
  for (const arg of rawArgs) {
    if (arg.startsWith('--')) {
      const [key, value] = arg.split('=');
      const normalizedKey = key.slice(2);
      flags[normalizedKey] = value !== undefined ? value : true;
    } else {
      args.push(arg);
    }
  }
  return { args, flags };
}

function parseAddArgs(args, manifest) {
  const candidates = args.slice(1);
  let targetDir = './src/app/ui';
  const componentNames = [];

  for (const candidate of candidates) {
    if (manifest.components[candidate]) {
      componentNames.push(candidate);
    } else if (componentNames.length > 0) {
      targetDir = candidate;
      break;
    } else {
      const available = Object.keys(manifest.components).sort().slice(0, 12).join(', ');
      console.error(`❌ Component "${candidate}" not found.`);
      console.error(`Run "volt list" to see all components. Available examples: ${available}`);
      process.exit(1);
    }
  }

  return { componentNames, targetDir };
}

/**
 * Resolves the backend for this invocation and refuses to mix engines in a directory that already
 * holds the other one. Exits with a message instead of throwing a stack trace.
 */
function selectBase(flags, targetDir) {
  let selection;
  try {
    selection = resolveBase(flags.base);
  } catch (err) {
    console.error(`❌ ${err.message}`);
    process.exit(1);
  }
  if (selection.base !== DEFAULT_BASE && !selection.recorded && targetUsesNgPrimitives(targetDir)) {
    console.error(
      `❌ ${targetDir} already contains components copied with the ng-primitives base.\n` +
        `   Copying a Quartz component next to them would mix engines without a record of it.\n` +
        `   Use another target-dir, or keep using ng-primitives for this directory.`
    );
    process.exit(1);
  }
  return selection;
}

const ACTION_LABELS = {
  create: 'create  ',
  reuse: 'reuse   ',
  replace: 'replace ',
  conflict: 'conflict',
};
const ACTION_NOTES = {
  create: '',
  reuse: ' (identical, left untouched)',
  replace: ' (differs; replaced because of --force)',
  conflict: ' (differs from the Volt UI source)',
};

function printPlan(plan) {
  console.log(`Requested: ${plan.requested.join(', ')}`);
  console.log(`Dependencies: ${plan.dependencies.join(', ') || '(none)'}`);
  console.log(`Shared files: ${plan.sharedFiles.join(', ') || '(none)'}`);
  console.log('Files:');
  for (const file of plan.files) {
    console.log(`  ${ACTION_LABELS[file.action]} ${file.targetPath}${ACTION_NOTES[file.action]}`);
  }
  const { barrel } = plan;
  if (barrel.action === 'unchanged') {
    console.log(`Barrel: ${barrel.path} already exports every component (unchanged)`);
  } else {
    console.log(`Barrel: ${barrel.action} ${barrel.path}, adding:`);
    barrel.added.forEach(name => console.log(`  export * from './${name}';`));
  }
}

function addCommand(plan, extra = '') {
  return `volt add ${plan.requested.join(' ')} ${plan.targetDir}${extra}${
    plan.base !== DEFAULT_BASE ? ` --base=${plan.base}` : ''
  }`;
}

/**
 * The whole `volt add` operation: one plan for every requested component, validated before the
 * first write, written with rollback, then (optionally) one package install.
 */
function runAdd({ componentNames, targetDir, manifest, base, requested, recorded, flags }) {
  const dryRun = !!flags['dry-run'];
  let plan;
  try {
    plan = planAdd({ componentNames, targetDir, manifest, base, force: !!flags.force });
  } catch (err) {
    console.error(`❌ ${err.message}`);
    process.exit(1);
  }

  const counts = action => filesWithAction(plan, action).length;

  if (dryRun) {
    console.log(
      `\n🔎 Dry run: ${plan.requested.length} component(s) would be added to ${targetDir}. Nothing was written.\n`
    );
    printPlan(plan);
    if (plan.conflicts.length > 0) {
      console.error(`\n❌ ${formatConflicts(plan, { dryRun: true })}`);
      process.exit(1);
    }
    if (flags.install) {
      console.log(`\n🔎 Runtime dependencies would be installed: ${plan.installCommand}`);
    }
    return;
  }

  if (plan.conflicts.length > 0) {
    console.error(`❌ ${formatConflicts(plan)}`);
    process.exit(1);
  }

  try {
    applyPlan(plan);
  } catch (err) {
    console.error(`❌ ${err.message}`);
    process.exit(1);
  }

  // An explicit --base is remembered, so later `volt add` calls keep the same engine.
  if (requested && !recorded) writeConfig(requested);

  console.log(`\n✅ Added ${plan.requested.length} component(s) successfully to ${targetDir}`);
  plan.requested.forEach(name => console.log(`  - ${name}`));
  if (plan.dependencies.length > 0) {
    console.log(`\n📦 Required dependencies:`);
    plan.dependencies.forEach(dep => console.log(`  - ${dep}`));
  }
  if (plan.sharedFiles.length > 0) {
    console.log(`\n🧩 Shared helpers: ${plan.sharedFiles.join(', ')}`);
  }
  console.log(
    `\nFiles: ${counts('create')} created, ${counts('reuse')} reused (identical), ${counts('replace')} replaced`
  );
  console.log(
    plan.barrel.added.length > 0
      ? `Barrel ${plan.barrel.path}: added ${plan.barrel.added.join(', ')}`
      : `Barrel ${plan.barrel.path}: unchanged`
  );

  console.log(`\nImport in your component:`);
  for (const name of plan.requested) {
    console.log(`  import { ${classNameFor(name)} } from './ui/${name}';`);
  }
  if (base !== DEFAULT_BASE) {
    console.log(`\n🧪 Headless base: ${base} (experimental).`);
  }

  if (flags.install) {
    try {
      installDependencies(process.cwd(), { dependencies: plan.runtimeDependencies });
    } catch {
      console.error(
        `\n❌ The component files above were written, but installing runtime dependencies failed.\n` +
          `   The copied files stay in place. Install the packages manually:\n` +
          `     ${plan.installCommand}`
      );
      process.exit(1);
    }
    console.log(`\n✅ Runtime dependencies installed.`);
  } else {
    console.log(`\n⚠️  Ensure runtime dependencies are installed:`);
    console.log(`  ${plan.installCommand}`);
    console.log(`\n  Or run: ${addCommand(plan, ' --install')}`);
  }
}

async function main() {
  const { args, flags } = parseArgs(process.argv.slice(2));
  const command = args[0];

  if (command === 'add') {
    if (args.length < 2) {
      console.error('❌ Please specify at least one component name.');
      console.log(
        'Usage: volt add <component-name>... [target-dir] [--install] [--dry-run] [--force]'
      );
      process.exit(1);
    }

    const manifest = await loadManifest();
    const { componentNames, targetDir } = parseAddArgs(args, manifest);
    const { base, requested, recorded } = selectBase(flags, targetDir);
    runAdd({ componentNames, targetDir, manifest, base, requested, recorded, flags });
  } else if (command === 'init') {
    const targetDir = args[1] || './src/app/ui';
    const { base, requested, recorded } = selectBase(flags, targetDir);
    let init;
    try {
      init = initProject(targetDir);
    } catch (err) {
      console.error(`❌ ${err.message}`);
      process.exit(1);
    }
    console.log('✅ Initialized volt/ui in', targetDir);
    console.log(
      init.createdIndex
        ? `   Created ${init.indexPath}`
        : `   Kept the existing ${init.indexPath} unchanged`
    );
    // Only an explicit --base writes volt.json: a project that never asks keeps the old behaviour.
    if (requested && !recorded) {
      writeConfig(requested);
      console.log(`✅ Recorded base "${requested}" in ${CONFIG_FILE}`);
    }
    if (base !== DEFAULT_BASE) {
      const supported = componentsForBase(await loadManifest(), base);
      console.log(`🧪 The "${base}" base is experimental and supports: ${supported.join(', ')}.`);
    }

    const tailwind = detectTailwindSetup(process.cwd());
    if (!tailwind.configured) {
      console.log(`\n${formatTailwindGuidance(tailwind)}`);
    }
  } else if (command === 'list') {
    const manifest = await loadManifest();
    const status = typeof flags.status === 'string' ? flags.status : null;
    const validStatuses = ['stable', 'beta', 'experimental'];
    if (status && !validStatuses.includes(status)) {
      console.error(`❌ Unknown status "${status}". Use one of: ${validStatuses.join(', ')}`);
      process.exit(1);
    }

    let base;
    try {
      base = flags.base === undefined ? undefined : validateBase(flags.base);
    } catch (err) {
      console.error(`❌ ${err.message}`);
      process.exit(1);
    }
    const components = listComponents(manifest, { status, base });
    if (flags.json) {
      console.log(JSON.stringify(components, null, 2));
      return;
    }

    console.log(status ? `Available ${status} components:` : 'Available components:');
    const groups = groupComponents(components);
    for (const [group, items] of Object.entries(groups)) {
      console.log(`\n${group}`);
      for (const item of items) {
        const statusLabel = item.stability.padEnd(12);
        const description = item.description ? ` - ${item.description}` : '';
        console.log(`  - ${item.name.padEnd(16)} ${statusLabel}${description}`);
      }
    }
  } else {
    console.log('Volt UI CLI');
    console.log('');
    console.log('Usage:');
    console.log('  volt init [target-dir]                Initialize volt/ui in your project');
    console.log(
      '  volt init [target-dir] --base=quartz  Also record the headless base (ng-primitives | quartz)'
    );
    console.log(
      '  volt add <component>... [target-dir]  Add one or more components to your project'
    );
    console.log('  volt add <component>... [target-dir] --dry-run  Preview files without writing');
    console.log(
      '  volt add <component>... [target-dir] --force    Replace files that differ from the Volt UI source'
    );
    console.log(
      '  volt add <component>... --install     Add component(s) and install runtime deps'
    );
    console.log('  volt list                             List all available components');
    console.log('  volt list --status=stable             List components by stability');
    console.log('  volt list --json                      Print component metadata as JSON');
    console.log(
      '  volt list --base=quartz               List components that have a Quartz implementation'
    );
    console.log(
      '  volt add <component>... --base=quartz Copy the experimental Quartz Headless version'
    );
    console.log('');
    console.log('Examples:');
    console.log('  npx @voltui/cli init');
    console.log('  npx @voltui/cli add button');
    console.log('  npx @voltui/cli add button card input');
    console.log('  npx @voltui/cli add card --install');
    console.log('  npx @voltui/cli add checkbox switch toggle --base=quartz');
  }
}

main().catch(err => {
  console.error('❌ Unexpected error:', err.message);
  process.exit(1);
});
