{
  "mcpServers": {
    "angular-cli": {
      "args": ["--no-install", "ng", "mcp"],
      "command": "npx"
    },
    "chrome-devtools": {
      "args": ["-y", "chrome-devtools-mcp@latest"],
      "command": "npx"
    },
    "codebase-memory": {
      "command": "npx",
      "args": ["-y", "codebase-memory-mcp"]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "glossa": {
      "headers": {
        "Authorization": "Bearer ${GLOSSA_TOKEN}"
      },
      "type": "http",
      "url": "https://glossa.andersseen.dev/mcp"
    },
    "ngp-mcp": {
      "args": ["--no-install", "ngp-mcp"],
      "command": "npx"
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--browser", "chromium"]
    },
    "volt-ui": {
      "type": "http",
      "url": "https://volt-ui.pages.dev/api/mcp"
    }
  }
}
